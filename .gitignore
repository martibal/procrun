*.pem
*.key
secrets/

# Runtime data: NEVER commit datasets or caches
data/raw/
data/cache/
data/downloads/
data/exports/
data/db/
cache/
downloads/
exports/
*.db
*.sqlite
*.sqlite3
*.parquet
*.feather
*.arrow
*.duckdb
*.gz
*.zip
*.7z
*.tar
*.tgz

# Model weights / large binaries
models/
*.bin
*.safetensors
*.gguf
*.onnx

# Logs
logs/
*.log

# Keep only explicitly curated tiny fixtures
!tests/fixtures/**
