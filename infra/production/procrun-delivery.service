[Unit]
Description=ProcRun fail-closed live delivery
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=procrun
Group=procrun
WorkingDirectory=/opt/procrun/current
EnvironmentFile=/etc/procrun/procrun.env
ExecStart=/opt/procrun/venv/bin/python scripts/run_live_delivery.py --output /var/lib/procrun/published/runway.jsonl
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/procrun /var/backups/procrun
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
