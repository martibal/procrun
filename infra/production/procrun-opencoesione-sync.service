[Unit]
Description=Refresh ProcRun OpenCoesione Lombardia admitted cache
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=procrun
Group=procrun
WorkingDirectory=/opt/procrun/current
EnvironmentFile=/etc/procrun/procrun.env
ExecStart=/opt/procrun/venv/bin/python scripts/sync_opencoesione.py --cache /var/lib/procrun/cache/opencoesione-lombardia.json
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/procrun
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
